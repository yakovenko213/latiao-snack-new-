rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Каталог доступний відвідувачам сайту для читання.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Інші колекції використовуються адмін-панеллю після anonymous auth.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
